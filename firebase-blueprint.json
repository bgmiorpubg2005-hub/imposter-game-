{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "A player in a game session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "word": { "type": "string" },
        "isImposter": { "type": "boolean" },
        "isReady": { "type": "boolean" },
        "clue": { "type": "string" },
        "vote": { "type": "string" },
        "score": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["id", "name", "isImposter", "isReady", "score", "color"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in the game chat",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "text": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["name", "text", "color"]
    },
    "Room": {
      "title": "Room",
      "description": "A game room session",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["lobby", "reveal", "clue", "discussion", "voting", "results"] },
        "players": { 
          "type": "object",
          "description": "Map of player IDs to Player objects"
        },
        "wordA": { "type": "string" },
        "wordB": { "type": "string" },
        "currentCluePlayerId": { "type": "string" },
        "timer": { "type": "number" },
        "winner": { "type": "string", "enum": ["players", "imposter"] },
        "roomCode": { "type": "string" },
        "chat": {
          "type": "array",
          "items": { "$ref": "ChatMessage" }
        }
      },
      "required": ["status", "players", "timer", "roomCode"]
    },
    "UserStats": {
      "title": "UserStats",
      "description": "Persistent user statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalScore": { "type": "number" },
        "gamesPlayed": { "type": "number" },
        "gamesWon": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "totalScore", "gamesPlayed", "gamesWon"]
    }
  },
  "firestore": {
    "/rooms/{roomCode}": {
      "schema": "Room",
      "description": "Active game rooms"
    },
    "/users/{uid}": {
      "schema": "UserStats",
      "description": "User profiles and statistics"
    }
  }
}
