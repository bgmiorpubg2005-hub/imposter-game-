rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string
    //   - email: string
    //   - photoURL: string
    //   - totalScore: number (required)
    //   - gamesPlayed: number (required)
    //   - gamesWon: number (required)
    //   - createdAt: timestamp
    //
    // Collection: rooms
    // Document ID: {roomCode}
    // Fields:
    //   - status: string (required)
    //   - players: map (required)
    //   - wordA: string
    //   - wordB: string
    //   - timer: number (required)
    //   - roomCode: string (required)
    //   - chat: list
    //   - winner: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "bgmiorpubg2005@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'totalScore', 'gamesPlayed', 'gamesWon']) &&
             data.uid is string &&
             data.totalScore is number &&
             data.gamesPlayed is number &&
             data.gamesWon is number;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['status', 'players', 'timer', 'roomCode']) &&
             data.status in ['lobby', 'reveal', 'clue', 'discussion', 'voting', 'results'] &&
             data.players is map &&
             data.timer is number &&
             data.roomCode is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /rooms/{roomCode} {
      allow read: if true; // Publicly readable to allow joining via code
      allow create: if isAuthenticated() && isValidRoom(request.resource.data);
      allow update: if isAuthenticated() && isValidRoom(request.resource.data);
      allow delete: if isAdmin();
      
      match /signaling/{signalId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
